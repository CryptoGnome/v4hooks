---
import Layout from "../../layouts/Layout.astro";
import CutSheet from "../../components/CutSheet.astro";
import SponsorBoard from "../../components/SponsorBoard.astro";
import { hooksForCategory, usedCategories } from "../../lib/catalog";
import { categoryBySlug } from "../../lib/meta";

export function getStaticPaths() {
  return usedCategories().map((c) => ({ params: { category: c.slug } }));
}

const category = categoryBySlug(Astro.params.category!);
if (!category) throw new Error("missing category");
const hooks = hooksForCategory(category.slug);
---
<Layout
  title={`${category.name} Uniswap v4 hooks`}
  description={`Best-effort directory of Uniswap v4 ${category.name.toLowerCase()} hooks you can evaluate and use. ${category.blurb}`}
  jsonLd={{ "@context": "https://schema.org", "@type": "ItemList", name: `${category.name} Uniswap v4 hooks`, numberOfItems: hooks.length }}
>
  <div class="layout">
    <main>
      <section class="lede">
        <h1>{category.name} Uniswap v4 hooks</h1>
        <p class="answer">{category.blurb} This is a curated product index, not Uniswap’s official hooklist.</p>
      </section>
      {hooks.map((hook) => <CutSheet hook={hook} />)}
    </main>
    <SponsorBoard />
  </div>
</Layout>
