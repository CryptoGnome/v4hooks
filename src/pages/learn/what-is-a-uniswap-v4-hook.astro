---
import Layout from "../../layouts/Layout.astro";
import SponsorBoard from "../../components/SponsorBoard.astro";
import { loadHooks } from "../../lib/catalog";
import { SITE } from "../../lib/meta";

const count = loadHooks().length;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is a Uniswap v4 hook?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "A Uniswap v4 hook is an external smart contract attached to a liquidity pool that runs custom logic before or after pool actions such as initialize, swap, add liquidity, remove liquidity, and donate.",
      },
    },
    {
      "@type": "Question",
      name: "Is v4hooks the official Uniswap registry?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Uniswap/hooklist is the official on-chain deployment registry. v4hooks is a directory of example hook contracts and Solidity snippets for builders and agents.",
      },
    },
  ],
};
---
<Layout
  title="What is a Uniswap v4 hook?"
  description="A Uniswap v4 hook is a contract attached to a pool that runs at defined points in swap and liquidity lifecycle. How flags, addresses, and directories differ."
  jsonLd={jsonLd}
>
  <div class="layout">
    <article class="prose">
      <p class="note">Last updated 2026-08-27 · {count} listings on v4hooks</p>
      <h1>What is a Uniswap v4 hook?</h1>
      <p class="answer">
        A Uniswap v4 hook is an external smart contract attached to a liquidity pool. It can run custom logic before or after pool actions — initialize, swap, add or remove liquidity, and donate — so a pool can charge dynamic fees, fill limit orders, or launch a token without forking the AMM.
      </p>
      <p>
        Uniswap documents this in the official <a href="https://docs.uniswap.org/contracts/v4/overview">v4 overview</a> and <a href="https://docs.uniswap.org/contracts/v4/concepts/hooks">hooks concept page</a>. Each pool has at most one hook. One hook can serve many pools. Permissions are encoded in the hook’s address bits so PoolManager knows which callbacks to call.
      </p>
      <h2>The 14 permission bits</h2>
      <p>
        before/after initialize, add liquidity, remove liquidity, swap, donate, plus return-delta variants on swap and liquidity. If the bit is off, PoolManager skips that callback. Always verify the deployed address matches the flags you think you are calling.
      </p>
      <h2>Directory vs registry</h2>
      <table>
        <thead>
          <tr><th>Surface</th><th>Job</th></tr>
        </thead>
        <tbody>
          <tr><td><a href="https://github.com/Uniswap/hooklist">Uniswap/hooklist</a></td><td>Canonical address + flags per chain</td></tr>
          <tr><td><a href="https://hookrank.io/">HookRank</a></td><td>Analytics and ranking</td></tr>
          <tr><td><a href="https://hookatlas.com/">Hook Atlas</a></td><td>Builder inspiration</td></tr>
          <tr><td><a href={SITE.url}>v4hooks</a></td><td>Example contracts and Solidity snippets to implement hooks</td></tr>
        </tbody>
      </table>
      <h2>How to pick a hook</h2>
      <ol>
        <li>Match the job (TWAMM, limit order, oracle, launchpad).</li>
        <li>Read the Solidity excerpt and the full file at the source URL.</li>
        <li>Match <code>getHookPermissions</code> to the bits in the deployed address.</li>
        <li>Listing here is not an audit. Confirm bytecode on hooklist before you route.</li>
      </ol>
      <h2>For agents</h2>
      <p>
        Start at <a href="/llms.txt">/llms.txt</a>, dump <a href="/llm-full.txt">/llm-full.txt</a>, or fetch <a href="/hooks.json">/hooks.json</a>. Contribute with a YAML file and a pull request; see CONTRIBUTING.md.
      </p>
    </article>
    <SponsorBoard />
  </div>
</Layout>
