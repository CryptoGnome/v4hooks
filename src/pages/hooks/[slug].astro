---
import Layout from "../../layouts/Layout.astro";
import SponsorBoard from "../../components/SponsorBoard.astro";
import { getHook, loadHooks, paragraph } from "../../lib/catalog";
import { FLAG_ORDER, SITE } from "../../lib/meta";
import { categoryBySlug, chainBySlug, propertyBySlug } from "../../lib/meta";

export function getStaticPaths() {
  return loadHooks().map((hook) => ({ params: { slug: hook.slug } }));
}

const { slug } = Astro.params;
const hook = getHook(slug!);
if (!hook) throw new Error("missing hook");
const desc = paragraph(hook.description).slice(0, 158);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareSourceCode",
      name: hook.name,
      programmingLanguage: "Solidity",
      codeRepository: hook.source.repo,
      license: hook.license,
      description: hook.tagline,
      url: `${SITE.url}/hooks/${hook.slug}`,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "v4hooks", item: SITE.url },
        { "@type": "ListItem", position: 2, name: hook.name, item: `${SITE.url}/hooks/${hook.slug}` },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: `How does the ${hook.name} Uniswap v4 hook work?`,
          acceptedAnswer: { "@type": "Answer", text: hook.tagline },
        },
        {
          "@type": "Question",
          name: `Which chains run ${hook.name}?`,
          acceptedAnswer: { "@type": "Answer", text: hook.chains.map((c) => chainBySlug(c)?.name ?? c).join(", ") },
        },
      ],
    },
  ],
};
---
<Layout title={`${hook.name} — Uniswap v4 hook`} description={desc} jsonLd={jsonLd}>
  <div class="layout">
    <article class="prose">
      <p class="note">{hook.kind} · {hook.license} · last updated {hook.updated}</p>
      <h1>{hook.name}</h1>
      <p class="answer">{hook.tagline}</p>
      {hook.description.split(/\n\n+/).map((p) => <p>{p.trim()}</p>)}
      <h2>Solidity</h2>
      <p class="note">
        Excerpt from <a href={hook.source.url}>{hook.source.path ?? hook.source.url}</a>.
        {hook.kind === "pattern" ? " Copy the full file to implement this." : " Production hook — study the callbacks, do not paste it as your factory."}
        Not an audit.
      </p>
      <pre class="sol"><code>{hook.solidity.trim()}</code></pre>
      <h2>Permission bits</h2>
      <p>These bits must match the deployed address. Confirm on-chain before you route.</p>
      <ul>
        {FLAG_ORDER.filter((f) => hook.flags.includes(f)).map((f) => <li><code>{f}</code></li>)}
      </ul>
      <h2>Spec</h2>
      <table>
        <tbody>
          <tr><th>Kind</th><td>{hook.kind}</td></tr>
          <tr><th>Status</th><td>{hook.status}</td></tr>
          <tr><th>License</th><td>{hook.license}</td></tr>
          <tr><th>Source</th><td><a href={hook.source.url}>{hook.source.repo}</a></td></tr>
          <tr><th>Categories</th><td>{hook.categories.map((c) => <a href={`/categories/${c}`}>{categoryBySlug(c)?.name}</a>)}</td></tr>
          <tr><th>Properties</th><td>{hook.properties.map((p) => <a href={`/properties/${p}`}>{propertyBySlug(p)?.name}</a>)}</td></tr>
          <tr><th>Chains</th><td>{hook.chains.map((c) => <a href={`/chains/${c}`}>{chainBySlug(c)?.name}</a>)}</td></tr>
          {hook.website && <tr><th>Website</th><td><a href={hook.website}>{hook.website}</a></td></tr>}
          {hook.docs && <tr><th>Docs</th><td><a href={hook.docs}>{hook.docs}</a></td></tr>}
          {hook.audit_url && <tr><th>Audit</th><td><a href={hook.audit_url}>{hook.audit_url}</a></td></tr>}
        </tbody>
      </table>
      {hook.deployments?.length ? (
        <>
          <h2>Known deployments</h2>
          <p>Verify bytecode yourself before routing. Addresses here are optional hints, not a guarantee.</p>
          <table>
            <thead><tr><th>Chain</th><th>Address</th></tr></thead>
            <tbody>
              {hook.deployments.map((d) => (
                <tr>
                  <td>{chainBySlug(d.chain)?.name ?? d.chain}</td>
                  <td><code>{d.address}</code>{d.hooklist ? " · hooklist" : ""}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </>
      ) : null}
      <h2>FAQ</h2>
      <p><strong>Can I paste this into production?</strong> The snippet is an excerpt. Use the full file at the source URL, match flags to the address, and treat this page as a map, not a guarantee.</p>
      <p><strong>How do I build this safely?</strong> Start with <a href="/learn/secure-v4-hooks">secure v4 hooks</a> and the <a href="/learn/openzeppelin-hooks">OpenZeppelin hooks</a> guide.</p>
    </article>
    <SponsorBoard />
  </div>
</Layout>
