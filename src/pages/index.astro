---
import Layout from "../layouts/Layout.astro";
import CutSheet from "../components/CutSheet.astro";
import BitLegend from "../components/BitLegend.astro";
import SponsorBoard from "../components/SponsorBoard.astro";
import { loadHooks, latestUpdate, usedCategories, usedChains, usedProperties } from "../lib/catalog";
import { SITE } from "../lib/meta";

const hooks = loadHooks();
const patterns = hooks.filter((h) => h.kind === "pattern");
const products = hooks.filter((h) => h.kind === "product");
const updated = latestUpdate(hooks);
const chains = usedChains(hooks);
const categories = usedCategories(hooks);
const properties = usedProperties(hooks);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: SITE.name,
      url: SITE.url,
      description: SITE.description,
    },
    {
      "@type": "ItemList",
      name: "Uniswap v4 hook examples",
      numberOfItems: hooks.length,
      itemListElement: hooks.map((h, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE.url}/hooks/${h.slug}`,
        name: h.name,
      })),
    },
  ],
};
---
<Layout title="Uniswap v4 hooks directory" description={SITE.description} jsonLd={jsonLd}>
  <div class="layout">
    <main>
      <section class="lede">
        <h1>Uniswap v4 hooks you can build</h1>
        <p class="answer">
          Example contracts and Solidity snippets for the callbacks you need — TWAMM, limit orders, oracles, launchpads. Built for agents and people implementing a hook.
        </p>
        <p>
          Each listing is a licensed excerpt plus a permalink to the full file. <em>pattern</em> means copy it. <em>product</em> means study how a live protocol wired the bits. Listing is not an audit.
        </p>
        <div class="meta-row">
          <span><b id="shown">{hooks.length}</b> listings</span>
          <span>Updated <b>{updated}</b></span>
          <span><a href="/learn">Learn</a></span>
          <span><a href="/learn/secure-v4-hooks">Secure hooks</a></span>
        </div>
      </section>
      <div class="filters">
        <label class="filter search">
          <span>Search</span>
          <input id="q" type="search" placeholder="Name or job" />
        </label>
        <label class="filter">
          <span>Chain</span>
          <select id="chain">
            <option value="">All chains</option>
            {chains.map((c) => <option value={c.slug}>{c.name}</option>)}
          </select>
        </label>
        <label class="filter">
          <span>Category</span>
          <select id="cat">
            <option value="">All categories</option>
            {categories.map((c) => <option value={c.slug}>{c.name}</option>)}
          </select>
        </label>
        <label class="filter">
          <span>Property</span>
          <select id="prop">
            <option value="">All properties</option>
            {properties.map((p) => <option value={p.slug}>{p.name}</option>)}
          </select>
        </label>
      </div>
      <div class="chips" id="chips"></div>
      <BitLegend />
      <div class="tabs" role="tablist" aria-label="Listing kind">
        <button type="button" class="tab" role="tab" id="tab-all" aria-controls="panel-pattern panel-product" aria-selected="true" data-kind="all">
          All <span class="tab-count" data-count="all">{hooks.length}</span>
        </button>
        <button type="button" class="tab" role="tab" id="tab-pattern" aria-controls="panel-pattern" aria-selected="false" tabindex="-1" data-kind="pattern">
          Patterns <span class="tab-count" data-count="pattern">{patterns.length}</span>
        </button>
        <button type="button" class="tab" role="tab" id="tab-product" aria-controls="panel-product" aria-selected="false" tabindex="-1" data-kind="product">
          Products <span class="tab-count" data-count="product">{products.length}</span>
        </button>
      </div>
      <section class="kind-block" id="panel-pattern" role="tabpanel" aria-labelledby="tab-pattern" data-kind="pattern">
        <h2 class="kind-label">Patterns</h2>
        <p class="kind-note">Copy the full source file to implement these.</p>
        <div class="index-list">
          {patterns.map((hook) => (
            <div class="row" data-name={hook.name.toLowerCase()} data-tagline={hook.tagline.toLowerCase()} data-chains={hook.chains.join(" ")} data-cats={hook.categories.join(" ")} data-props={hook.properties.join(" ")} data-kind={hook.kind}>
              <CutSheet hook={hook} heading="h3" />
            </div>
          ))}
        </div>
      </section>
      <section class="kind-block" id="panel-product" role="tabpanel" aria-labelledby="tab-product" data-kind="product">
        <h2 class="kind-label">Products</h2>
        <p class="kind-note">Study the callbacks. Do not paste the factory.</p>
        <div class="index-list">
          {products.map((hook) => (
            <div class="row" data-name={hook.name.toLowerCase()} data-tagline={hook.tagline.toLowerCase()} data-chains={hook.chains.join(" ")} data-cats={hook.categories.join(" ")} data-props={hook.properties.join(" ")} data-kind={hook.kind}>
              <CutSheet hook={hook} heading="h3" />
            </div>
          ))}
        </div>
      </section>
      <p class="note" id="empty" hidden>No listings match those filters.</p>
    </main>
    <SponsorBoard />
  </div>
</Layout>
<script>
  const q = document.getElementById("q");
  const chain = document.getElementById("chain");
  const cat = document.getElementById("cat");
  const prop = document.getElementById("prop");
  const rows = [...document.querySelectorAll(".row")];
  const empty = document.getElementById("empty");
  const shown = document.getElementById("shown");
  const chips = document.getElementById("chips");
  const tabs = [...document.querySelectorAll(".tab")];
  const panels = new Map([...document.querySelectorAll(".kind-block")].map((el) => [el.dataset.kind, el]));
  const counts = new Map([...document.querySelectorAll(".tab-count")].map((el) => [el.dataset.count, el]));

  const params = new URLSearchParams(location.search);
  q.value = params.get("q") ?? "";
  chain.value = params.get("chain") ?? "";
  cat.value = params.get("cat") ?? "";
  prop.value = params.get("prop") ?? "";
  const KINDS = ["all", "pattern", "product"];
  let kind = KINDS.includes(params.get("kind")) ? params.get("kind") : "all";
  const labels = new Map([...document.querySelectorAll(".kind-label")].map((el) => [el.closest(".kind-block").dataset.kind, el]));

  function syncUrl() {
    const p = new URLSearchParams();
    if (q.value.trim()) p.set("q", q.value.trim());
    if (chain.value) p.set("chain", chain.value);
    if (cat.value) p.set("cat", cat.value);
    if (prop.value) p.set("prop", prop.value);
    if (kind !== "all") p.set("kind", kind);
    const qs = p.toString();
    history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
  }

  function apply() {
    const query = q.value.toLowerCase().trim();
    const ch = chain.value;
    const category = cat.value;
    const property = prop.value;
    const perKind = { pattern: 0, product: 0 };
    for (const row of rows) {
      const okQ = !query || row.dataset.name.includes(query) || row.dataset.tagline.includes(query);
      const okC = !ch || row.dataset.chains.split(" ").includes(ch);
      const okK = !category || row.dataset.cats.split(" ").includes(category);
      const okP = !property || row.dataset.props.split(" ").includes(property);
      const on = okQ && okC && okK && okP;
      row.hidden = !on;
      if (on) perKind[row.dataset.kind] += 1;
    }

    // Counts sit on the tabs so a filter that only matches the other kind is visible
    // rather than looking like zero results.
    perKind.all = perKind.pattern + perKind.product;
    for (const [k, el] of counts) {
      el.textContent = String(perKind[k]);
      el.dataset.empty = perKind[k] === 0 ? "true" : "false";
    }
    for (const tab of tabs) {
      const on = tab.dataset.kind === kind;
      tab.setAttribute("aria-selected", on ? "true" : "false");
      tab.tabIndex = on ? 0 : -1;
    }
    for (const [k, panel] of panels) {
      // A panel with no matches would render as a heading and a note over an empty
      // list, so drop it and let #empty speak instead.
      const visible = (kind === "all" || k === kind) && perKind[k] > 0;
      panel.hidden = !visible;
      // In All the two lists stack, so each needs its own visible heading. On a single
      // kind the tab already names it, so the heading drops to screen readers only.
      labels.get(k)?.classList.toggle("sr-only", kind !== "all");
    }

    empty.hidden = perKind[kind] !== 0;
    if (shown) shown.textContent = String(perKind[kind]);
    renderChips();
    syncUrl();
  }

  function selectedLabel(el) {
    return el.selectedOptions[0]?.textContent?.trim() ?? el.value;
  }

  function renderChips() {
    if (!chips) return;
    chips.textContent = "";
    const active = [];
    if (q.value.trim()) active.push(["Search", q.value.trim(), () => { q.value = ""; }]);
    if (chain.value) active.push(["Chain", selectedLabel(chain), () => { chain.value = ""; }]);
    if (cat.value) active.push(["Category", selectedLabel(cat), () => { cat.value = ""; }]);
    if (prop.value) active.push(["Property", selectedLabel(prop), () => { prop.value = ""; }]);

    for (const [label, value, clear] of active) {
      const chip = document.createElement("button");
      chip.type = "button";
      chip.className = "chip";
      chip.textContent = `${label}: ${value}`;
      chip.setAttribute("aria-label", `Clear ${label.toLowerCase()} filter`);
      chip.addEventListener("click", () => { clear(); apply(); });
      chips.append(chip);
    }

    if (active.length > 1) {
      const all = document.createElement("button");
      all.type = "button";
      all.className = "chip clear";
      all.textContent = "Clear all";
      all.addEventListener("click", () => {
        for (const [, , clear] of active) clear();
        apply();
      });
      chips.append(all);
    }
  }

  function selectTab(next, focus) {
    kind = next;
    apply();
    if (focus) tabs.find((t) => t.dataset.kind === next)?.focus();
  }

  for (const tab of tabs) {
    tab.addEventListener("click", () => selectTab(tab.dataset.kind, false));
    tab.addEventListener("keydown", (e) => {
      const i = tabs.indexOf(tab);
      let j = -1;
      if (e.key === "ArrowRight") j = (i + 1) % tabs.length;
      else if (e.key === "ArrowLeft") j = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === "Home") j = 0;
      else if (e.key === "End") j = tabs.length - 1;
      if (j < 0) return;
      e.preventDefault();
      selectTab(tabs[j].dataset.kind, true);
    });
  }

  q.addEventListener("input", apply);
  chain.addEventListener("change", apply);
  cat.addEventListener("change", apply);
  prop.addEventListener("change", apply);
  apply();
</script>
