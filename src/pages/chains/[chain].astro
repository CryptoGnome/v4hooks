---
import Layout from "../../layouts/Layout.astro";
import CutSheet from "../../components/CutSheet.astro";
import SponsorBoard from "../../components/SponsorBoard.astro";
import { hooksForChain, usedChains } from "../../lib/catalog";
import { chainBySlug } from "../../lib/meta";

export function getStaticPaths() {
  return usedChains().map((c) => ({ params: { chain: c.slug } }));
}

const chain = chainBySlug(Astro.params.chain!);
if (!chain) throw new Error("missing chain");
const hooks = hooksForChain(chain.slug);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Uniswap v4 hooks on ${chain.name}`,
  numberOfItems: hooks.length,
};
---
<Layout
  title={`Uniswap v4 hooks on ${chain.name}`}
  description={`Uniswap v4 hook example contracts documented on ${chain.name} — Solidity snippets, not a raw address dump.`}
  jsonLd={jsonLd}
>
  <div class="layout">
    <main>
      <section class="lede">
        <p class="crumbs"><a href="/">Index</a> / {chain.name}</p>
        <h1>Uniswap v4 hooks on {chain.name}</h1>
        <p class="answer">
          These listings are example hook contracts that mention {chain.name} (chain id {chain.id}). Read the Solidity on each page, then verify any live address yourself before you route.
        </p>
      </section>
      <div class="index-list">
        {hooks.map((hook) => <CutSheet hook={hook} />)}
      </div>
    </main>
    <SponsorBoard />
  </div>
</Layout>
