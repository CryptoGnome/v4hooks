---
import Layout from "../layouts/Layout.astro";
import SponsorBoard from "../components/SponsorBoard.astro";
---
<Layout
  title="Advertise on v4hooks"
  description="Bid USDC to rank on the v4hooks sponsor rail. Highest bid sits on top. Pay the difference to raise."
>
  <div class="layout">
    <main class="prose">
      <h1>Outbid the rail</h1>
      <p class="answer">
        The sidebar is a public leaderboard. Rank is the bid. Minimum 5 USDC. Ties keep the older listing. Already listed? Pay only the difference to move up.
      </p>
      <p>Pay USDC on Ethereum, Base, Arbitrum, Polygon, or Solana via MoonPay Commerce (Helio). Funds settle to USDC on Base. Payments are not refundable.</p>
      <form class="form" id="bid-form">
        <div class="field">
          <label for="name">Project name</label>
          <input id="name" name="name" required minlength="2" maxlength="80" />
        </div>
        <div class="field">
          <label for="url">HTTPS URL</label>
          <input id="url" name="url" type="url" required placeholder="https://example.com" />
        </div>
        <div class="field">
          <label for="tagline">One line</label>
          <input id="tagline" name="tagline" required minlength="8" maxlength="160" />
        </div>
        <div class="field">
          <label for="bid">Bid (USDC)</label>
          <input id="bid" name="bid" type="number" min="5" step="1" value="5" required />
        </div>
        <button type="submit">Lock in checkout</button>
        <p class="note" id="status"></p>
      </form>
      <div id="pay" hidden></div>
    </main>
    <SponsorBoard />
  </div>
</Layout>
<script>
  const form = document.getElementById("bid-form");
  const status = document.getElementById("status");
  const pay = document.getElementById("pay");
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    status.textContent = "Opening intent…";
    pay.hidden = true;
    const body = {
      name: form.name.value,
      url: form.url.value,
      tagline: form.tagline.value,
      bid_usdc: Number(form.bid.value),
    };
    const res = await fetch("/api/ads/intent", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(body),
    });
    const data = await res.json();
    if (!res.ok) {
      status.textContent = data.error || "Could not create bid";
      return;
    }
    status.textContent = data.would_be_first
      ? `That bid would take #1. Charge ${data.charge_usdc} USDC.`
      : `Charge ${data.charge_usdc} USDC for this rank.`;
    if (data.paylink_id) {
      pay.hidden = false;
      pay.innerHTML = `<p>Complete ${data.charge_usdc} USDC via Helio, then the rail updates.</p>
        <div class="helioCheckout" data-paylink-id="${data.paylink_id}" data-amount="${data.charge_usdc}" data-additional-json='${JSON.stringify({ bidId: data.id })}'></div>`;
      if (!document.getElementById("helio-sdk")) {
        const s = document.createElement("script");
        s.id = "helio-sdk";
        s.src = "https://embed.hel.io/assets/index-v1.js";
        s.async = true;
        document.body.appendChild(s);
      }
    } else {
      pay.hidden = false;
      pay.innerHTML = `<p class="note">Checkout is wired. Set <code>HELIO_PAYLINK_ID</code> on the Worker to accept live USDC. Bid id: <code>${data.id}</code></p>`;
    }
  });
</script>
