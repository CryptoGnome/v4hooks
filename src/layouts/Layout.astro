---
import "../styles/global.css";
import { SITE } from "../lib/meta";

type Props = {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: unknown;
};

const { title, description, canonical, jsonLd } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, ""), SITE.url).toString();
const fullTitle = title.includes("v4hooks") ? title : `${title} · v4hooks`;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="v4hooks" />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Spline+Sans+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="wrap">
      <header class="mast">
        <a class="brand" href="/">
          V4HOOKS
          <small>CUT SHEET DIRECTORY</small>
        </a>
        <nav>
          <a href="/" aria-current={path === "/" ? "page" : undefined}>Index</a>
          <a href="/learn/what-is-a-uniswap-v4-hook" aria-current={path.startsWith("/learn") ? "page" : undefined}>Learn</a>
          <a href="/advertise" aria-current={path === "/advertise" ? "page" : undefined}>Advertise</a>
          <a href="https://github.com/CryptoGnome/v4hooks">GitHub</a>
        </nav>
      </header>
      <slot />
      <footer class="foot">
        Listing is not an audit or endorsement. Address truth lives on Uniswap hooklist. Last generated at build. ·
        <a href="/llms.txt">llms.txt</a> ·
        <a href="/hooks.json">hooks.json</a>
      </footer>
    </div>
  </body>
</html>
