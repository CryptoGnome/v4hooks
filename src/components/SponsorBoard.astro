---
// The sponsor rail is paused. Flip this to true to bring it back — every call site is left
// in place and .layout re-widens on its own via :has(> .rail). The /api/ads Worker route and
// the D1 table are still there, but /advertise and its bid form are gone, so restoring the
// rail means restoring that page too.
const ENABLED = false;

type Props = { compact?: boolean };
const { compact = false } = Astro.props;
---
{ENABLED && (
<details class:list={["rail", compact && "compact"]} open>
  <summary>Sponsor rail</summary>
  <aside class="board" id="sponsor-board">
    <h2>Sponsor rail</h2>
    <p class="hint">
      {compact
        ? "Highest USDC bid sits on top."
        : "Highest USDC bid sits on top. Rank is the bid, nothing else."}
    </p>
    <ol id="sponsor-list">
      <li class="note">Loading live bids…</li>
    </ol>
  </aside>
</details>
<script is:inline>
  // Everything below is built with DOM APIs and textContent, never innerHTML. name, tagline
  // and url reach us from D1 via /api/ads, written by an endpoint with no authentication, so
  // they are untrusted strings. Interpolating them into innerHTML made a single listing a
  // stored XSS on every page that carries the rail.
  function el(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function note(text) {
    return el("li", "note", text);
  }

  function sponsorRow(row) {
    const li = document.createElement("li");

    const rank = el("div", "rank");
    rank.append(el("span", null, `#${row.rank}`), el("span", "bid", `${Number(row.bid_usdc).toFixed(0)} USDC`));

    const name = el("a", "name", row.name);
    name.rel = "noopener sponsored";
    // cleanUrl() in the Worker already rejects anything but https, but this is the sink, so
    // re-check rather than trust the row. A bad value renders as plain text, not a link.
    try {
      const u = new URL(row.url);
      if (u.protocol === "https:") name.href = u.href;
    } catch { /* unparseable url -- leave the anchor without an href */ }

    li.append(rank, name, el("p", "why", row.tagline));
    return li;
  }

  async function load() {
    const list = document.getElementById("sponsor-list");
    const rail = list?.closest(".rail");
    if (!list) return;
    try {
      const res = await fetch("/api/ads");
      const data = await res.json();
      const rows = data.listings ?? [];
      rail?.classList.toggle("empty", rows.length === 0);
      if (!rows.length) {
        list.replaceChildren(note("No live bids. First slot is 5 USDC."));
        return;
      }
      list.replaceChildren(...rows.map(sponsorRow));
    } catch {
      rail?.classList.add("empty");
      list.replaceChildren(note("Bid board wakes once the Worker API is deployed."));
    }
  }
  load();
  const mq = matchMedia("(min-width: 861px)");
  function syncRail() {
    document.querySelectorAll("details.rail").forEach((d) => {
      if (mq.matches) d.open = true;
      else if (!d.dataset.touched) d.open = false;
    });
  }
  document.querySelectorAll("details.rail").forEach((d) => {
    d.querySelector("summary")?.addEventListener("click", () => {
      d.dataset.touched = "1";
    });
  });
  mq.addEventListener("change", syncRail);
  syncRail();
</script>
)}
