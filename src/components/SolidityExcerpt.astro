---
import { Code } from "astro:components";
import { solidityTheme, booleanEmphasis } from "../lib/code-theme";

type Props = { code: string; lang?: "solidity" | "bash" };
const { code, lang = "solidity" } = Astro.props;
---
<div class="sol-wrap">
  <button type="button" class="copy">Copy</button>
  <Code code={code} lang={lang} theme={solidityTheme} transformers={[booleanEmphasis]} />
</div>
<script>
  document.querySelectorAll(".sol-wrap").forEach((el) => {
    const btn = el.querySelector(".copy");
    const src = el.querySelector("code")?.textContent ?? "";
    btn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(src);
        btn.textContent = "Copied";
      } catch {
        btn.textContent = "Copy failed";
      }
      setTimeout(() => {
        btn.textContent = "Copy";
      }, 1200);
    });
  });
</script>
