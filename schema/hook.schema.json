{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v4hooks.com/schema/hook.schema.json",
  "title": "v4hooks listing",
  "description": "One Uniswap v4 hook product. Group deployments under a single listing. Do not submit raw address-only clones of Uniswap/hooklist.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "tagline",
    "description",
    "categories",
    "chains",
    "status",
    "added",
    "updated"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "tagline": { "type": "string", "minLength": 12, "maxLength": 160 },
    "description": { "type": "string", "minLength": 280, "maxLength": 4000 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "dynamic-fees",
          "limit-orders",
          "twamm",
          "launchpads",
          "oracles",
          "ve",
          "rwa",
          "mev-protection",
          "lp-management",
          "lending",
          "wrappers",
          "creator-economy",
          "auctions",
          "compliance",
          "gaming"
        ]
      }
    },
    "chains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chain", "address"],
        "properties": {
          "chain": { "type": "string" },
          "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
          "hooklist": { "type": "boolean" }
        }
      }
    },
    "repo": { "type": "string", "format": "uri" },
    "docs": { "type": "string", "format": "uri" },
    "website": { "type": "string", "format": "uri" },
    "audit_url": { "type": "string", "format": "uri" },
    "license": { "type": "string", "minLength": 1, "maxLength": 40 },
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "beforeInitialize",
          "afterInitialize",
          "beforeAddLiquidity",
          "afterAddLiquidity",
          "beforeRemoveLiquidity",
          "afterRemoveLiquidity",
          "beforeSwap",
          "afterSwap",
          "beforeDonate",
          "afterDonate",
          "beforeSwapReturnDelta",
          "afterSwapReturnDelta",
          "afterAddLiquidityReturnDelta",
          "afterRemoveLiquidityReturnDelta"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": ["production", "experimental", "deprecated"]
    },
    "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}