{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v4hooks.com/schema/hook.schema.json",
  "title": "v4hooks listing",
  "description": "One Uniswap v4 hook you can build or study. The body is a licensed Solidity excerpt plus a permalink to the full file. Not a Uniswap/hooklist address dump.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "kind",
    "tagline",
    "description",
    "source",
    "solidity",
    "categories",
    "chains",
    "flags",
    "properties",
    "license",
    "status",
    "added",
    "updated"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "kind": {
      "type": "string",
      "enum": ["pattern", "product"],
      "description": "pattern = copy this to implement the job. product = production hook, excerpted so you can see how they wired callbacks."
    },
    "tagline": { "type": "string", "minLength": 12, "maxLength": 160 },
    "description": {
      "type": "string",
      "minLength": 280,
      "maxLength": 4000,
      "description": "How the callbacks work. Not marketing copy."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "repo"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://", "description": "Permalink to the Solidity file." },
        "repo": { "type": "string", "format": "uri", "pattern": "^https://" },
        "path": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "solidity": {
      "type": "string",
      "minLength": 120,
      "maxLength": 8000,
      "description": "Excerpt of getHookPermissions plus the callbacks that matter. Not the whole contract."
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "dynamic-fees",
          "limit-orders",
          "twamm",
          "launchpads",
          "oracles",
          "ve",
          "rwa",
          "mev-protection",
          "lp-management",
          "lending",
          "wrappers",
          "creator-economy",
          "auctions",
          "compliance",
          "gaming"
        ]
      }
    },
    "chains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chain", "address"],
        "properties": {
          "chain": { "type": "string" },
          "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
          "hooklist": { "type": "boolean" }
        }
      }
    },
    "docs": { "type": "string", "format": "uri", "pattern": "^https://" },
    "website": { "type": "string", "format": "uri", "pattern": "^https://" },
    "audit_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "license": { "type": "string", "minLength": 1, "maxLength": 40 },
    "flags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "beforeInitialize",
          "afterInitialize",
          "beforeAddLiquidity",
          "afterAddLiquidity",
          "beforeRemoveLiquidity",
          "afterRemoveLiquidity",
          "beforeSwap",
          "afterSwap",
          "beforeDonate",
          "afterDonate",
          "beforeSwapReturnDelta",
          "afterSwapReturnDelta",
          "afterAddLiquidityReturnDelta",
          "afterRemoveLiquidityReturnDelta"
        ]
      }
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Behavioral labels: dynamic fee, upgradeable proxy, needs custom hookData, or works with vanilla swaps.",
      "items": {
        "type": "string",
        "enum": [
          "dynamic-fee",
          "upgradeable",
          "custom-swap-data",
          "vanilla-swap"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": ["production", "experimental", "deprecated"]
    },
    "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
