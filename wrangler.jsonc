{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "v4hooks",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "v4hooks.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "v4hooks-ads",
      "database_id": "b782f01f-79b8-46f6-8464-376cf39eeba7"
    }
  ]
}